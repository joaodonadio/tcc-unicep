{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": { "api/v1/*.js": { "maxDuration": 60 }, "api/aquecer.js": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/aquecer", "schedule": "15 12 * * *" }],
  "rewrites": [
    { "source": "/api/v1/:caminho*", "destination": "/api/proxy?caminho=:caminho*" },
    {
      "source": "/((?!api/|assets/|dados/|modelos/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
