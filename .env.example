# Copie para .env e ajuste.

# De onde a interface lê os dados:
#   arquivos -> pacotes JSON de exemplo em public/dados/ (padrão, funciona sem internet)
#   api      -> API de leitura do processamento, via proxy do Vite em /api (padrão de produção)
#   simulado -> pacotes de public/dados completados com valores simulados, só para trabalhar o design
VITE_FONTE_DADOS=arquivos
VITE_API_PREFIXO=/api

# Só valem com VITE_FONTE_DADOS=simulado: atraso de cada resposta (ms, sorteado entre os dois)
# e chance de falha (0 a 1) para ver os estados de carregando e de erro dos cartões.
VITE_MOCK_LATENCY_MIN=0
VITE_MOCK_LATENCY_MAX=0
VITE_MOCK_ERROR_RATE=0

# Só valem com VITE_FONTE_DADOS=api. Nunca use o prefixo VITE_ nestas duas:
# a chave iria para o navegador e qualquer visitante a veria (F12).
API_BASE_URL=
API_KEY=

# Na Vercel: definir só API_BASE_URL e API_KEY nas variáveis do projeto (VITE_FONTE_DADOS=api já vem do .env.production)
# (Settings > Environment Variables). As funções em api/ leem as duas primeiras no servidor.
