# Provedor de LLM — o serviço isola o SDK atrás de uma interface própria (§4),
# então trocar de provedor é trocar a implementação em provedor.py.
ANTHROPIC_API_KEY=

# Modelo. O documento (§4) escolhe a variante rápida/econômica da família.
# Trocar para claude-sonnet-5 ou claude-opus-5 é só mudar esta linha — o serviço
# detecta sozinho que esses modelos não aceitam `temperature`.
AGENTE_MODELO=claude-haiku-4-5
AGENTE_TEMPERATURA=0.2
AGENTE_MAX_TOKENS=700

# API de predições do projeto maior — fonte única de verdade dos dados (§3)
API_PREDICOES_URL=http://localhost:8000
SNAPSHOT_TTL_SEGUNDOS=60

# Guardrails (§6.1)
LIMITE_CARACTERES=500
LIMITE_TURNOS_HISTORICO=20
RATE_LIMIT_POR_MINUTO=20

# Teto de orçamento: excedido, o serviço degrada para o modo regra (§4)
ORCAMENTO_MENSAL_USD=5.0

# CORS — origem do front
ORIGEM_FRONT=http://localhost:5173
