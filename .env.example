# Camada de dados (ARQUITETURA-INTERFACE.md §3 — estratégia mock-first)
# true  -> o adapter serve os JSONs de mocks/ com latência simulada
# false -> o Axios chama VITE_API_BASE_URL de verdade
VITE_USE_MOCKS=true

# Latência simulada dos mocks (ms) e taxa de erro (0..1) para exercitar
# os 4 estados de cada card: skeleton / dados / vazio / erro.
VITE_MOCK_LATENCY_MIN=300
VITE_MOCK_LATENCY_MAX=800
VITE_MOCK_ERROR_RATE=0

# API REST do projeto maior (FastAPI) — /api/analise-do-dia, /api/historico/{ticker}...
VITE_API_BASE_URL=http://localhost:8000

# Serviço agente-chat (AGENTE-CHAT-IA.md §7 — POST /chat)
# Interruptor próprio: permite usar o agente real mesmo com os dados em mock,
# já que os dois back-ends sobem em momentos diferentes.
VITE_USE_CHAT_SERVICE=false
VITE_CHAT_BASE_URL=http://localhost:8100
